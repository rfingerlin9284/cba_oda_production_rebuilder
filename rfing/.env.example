# ════════════════════════════════════════════════════════════════════════════════
# CBA_ODA Production Rebuilder — Master Environment Template
# Copy this file to .env and fill in your real API credentials.
# NEVER commit the .env file to version control.
# ════════════════════════════════════════════════════════════════════════════════

# ── OANDA Forex Bot ─────────────────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
# practice | live
OANDA_ENVIRONMENT=practice
OANDA_BASE_URL=https://api-fxtrade.oanda.com
OANDA_STREAM_URL=https://stream-fxtrade.oanda.com

# ── Coinbase Advanced Trade Bot ──────────────────────────────────────────────────
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here
# true | false  (set false for paper/sandbox mode)
COINBASE_SANDBOX=false

# ── Global Bot Settings ──────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=/home/rfing/logs

# Maximum risk per trade (as a fraction of account balance)
MAX_RISK_PER_TRADE=0.01

# Stop-loss distance in pips used for OANDA position sizing (default 10 pips)
OANDA_STOP_LOSS_PIPS=10

# ── Notification / Alerting (optional) ──────────────────────────────────────────
# Telegram bot token and chat ID for trade alerts (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
